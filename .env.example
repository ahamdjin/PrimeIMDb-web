# Set either a TMDB v4 read access token or v3 API key, server-side only.
TMDB_API_READ_TOKEN=
TMDB_API_KEY=
# Supplemental integrations are optional and must comply with provider licenses.
OMDB_API_KEY=
ENABLE_TVMAZE=false
# Supply an actual production domain before launch.
SITE_URL=https://yourdomain.com
VITE_SITE_URL=https://yourdomain.com
