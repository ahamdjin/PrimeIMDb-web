# REQUIRED: obtain either a TMDB v4 read token OR a TMDB v3 API key
# Server-only keys: never use VITE_ in secret names.
TMDB_API_READ_TOKEN=
TMDB_API_KEY=

# OPTIONAL: supplement TMDB with third-party API providers
# OMDb: IMDb-linked additional scores and awards
OMDB_API_KEY=
# TVmaze public API: show status/network; no key required
ENABLE_TVMAZE=false
# Watchmode: richer region-based streaming sources and direct links if provided.
# Watchmode may bill credits per title look-up (often 2 credits with a TMDB ID).
WATCHMODE_API_KEY=

# Use the final public website URL. Do not use example.com in production.
SITE_URL=https://yourdomain.com
VITE_SITE_URL=https://yourdomain.com
