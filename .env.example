# Required primary movie/TV catalog. Choose one.
TMDB_API_READ_TOKEN=
TMDB_API_KEY=
# Legacy Screenbox credentials are supported.
MOVIE_DB_API_KEY=
MOVIE_DB_URL=https://api.themoviedb.org/3

# Optional enrichment sources; leave unset if you have no license/key.
OMDB_API_KEY=
WATCHMODE_API_KEY=
NYT_MOVIE_REVIEWS_API_KEY=
THETVDB_API_KEY=
THETVDB_PIN=
# TVmaze and Wikidata are public APIs; enable explicitly after reviewing licensing/attribution.
ENABLE_TVMAZE=false
ENABLE_WIKIDATA=false
# Your public canonical host. Not a secret.
NEXT_PUBLIC_SITE_URL=https://prime-imdb-web.vercel.app
